{
  "$schema": "https://opencode.ai/config.json",
  "theme": "ayu-dark",
  "model": "openai/gpt-5.6-terra",
  "default_agent": "build",
  "provider": {
    "openai": {
      "options": {
        "headerTimeout": 60000,
        "timeout": 600000,
        "chunkTimeout": 60000
      }
    }
  },
  "agent": {
    "build": {
      "color": "#3de070",
      "model": "openai/gpt-5.6-terra"
    },
    "quick": {
      "color": "#5cc8ff",
      "model": "openai/gpt-5.6-luna",
      "variant": "medium",
      "mode": "primary"
    },
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "color": "#a78bfa",
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow",
          "general": "deny",
          "review": "deny"
        }
      }
    },
    "general": {
      "model": "opencode-go/minimax-m3",
      "mode": "subagent"
    },
    "explore": {
      "model": "opencode-go/deepseek-v4-flash",
      "mode": "subagent"
    },
    "review": {
      "model": "opencode-go/minimax-m3",
      "mode": "subagent"
    }
  },
  "compaction": {
    "prune": true
  },
  "plugin": ["@tarquinen/opencode-dcp@latest"]
}
