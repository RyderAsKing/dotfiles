{
  "$schema": "https://opencode.ai/config.json",
  "theme": "ayu-dark",
  "default_agent": "build",
  "provider": {
    "openai": {
      "options": {
        "headerTimeout": 60000,
        "timeout": 600000,
        "chunkTimeout": 60000
      }
    }
  },
  "agent": {
    "build": {
      "color": "#3de070",
      "model": "openai/gpt-5.6-terra",
      "variant": "high",
      "mode": "primary"
    },
    "quick": {
      "color": "#5cc8ff",
      "model": "openai/gpt-5.6-luna",
      "variant": "medium",
      "mode": "primary"
    },
    "go": {
      "color": "#38bdf8",
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "max",
      "mode": "primary"
    },
    "plan": {
      "color": "#a78bfa",
      "model": "openai/gpt-5.6-sol",
      "variant": "medium",
      "mode": "primary"
    },
    "general": {
      "model": "openai/gpt-5.6-luna",
      "variant": "high",
      "mode": "subagent"
    },
    "explore": {
      "model": "opencode-go/deepseek-v4-flash",
      "mode": "subagent"
    },
    "review": {
      "model": "opencode-go/minimax-m3",
      "mode": "subagent"
    }
  },
  "compaction": {
    "prune": true
  },
  "plugin": ["@tarquinen/opencode-dcp@latest"]
}
