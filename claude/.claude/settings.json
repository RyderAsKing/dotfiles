{
  "model": "opus[1m]",
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "autoCompactWindow": 307200,
  "theme": "dark",
  "env": {
    "MCP_TOOL_TIMEOUT": "3600000"
  },
  "permissions": {
    "allow": [
      "mcp__pi__delegate"
    ],
    "deny": [
      "Agent"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-builtin-agent.sh"
          }
        ]
      }
    ]
  },
  "enableArtifact": false,
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "anthropic-skills:docx": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:xlsx": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:chrome-browser": "off",
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:deep-research": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:skill-creator": "off",
    "artifact-design": "off",
    "artifact-diagramming": "off",
    "artifact-capabilities": "off",
    "dataviz": "user-invocable-only",
    "claude-api": "user-invocable-only"
  }
}
